# NYSC-Hub environment variables.
# Copy to `.env` and fill in. Validated at boot by src/config/env.ts (zod).
# Never commit a filled `.env` — .gitignore covers it.

# Mongo database (Atlas free/shared tier for the pilot)
MONGODB_URI=mongodb+srv://shekinah:shekinah@nodetuts.m5oxomk.mongodb.net/nysc-hub

# Auth.js — generate with: openssl rand -base64 32  (min 32 chars)
NEXTAUTH_SECRET=NEXT-AUTH-SECRET

# Public app URL (optional in dev, required in production)
NEXTAUTH_URL=http://localhost:3000

# Transactional email (Resend). Optional in dev: a console sender logs links.
EMAIL_FROM=noreply@example.com
RESEND_API_KEY=
